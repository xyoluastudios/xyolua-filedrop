# XyoLua FileDrop configuration.
# Copy to .env (Docker Compose picks it up) or export the variables before `npm start`.
# Every value shown here is the default.

# --- Server ---------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
# Public URL of your instance. Used for the links returned by the API.
# Leave empty to derive it from the request (fine for local use).
BASE_URL=
# Where uploads and metadata are stored (relative paths are relative to the project folder).
DATA_DIR=data
# Name shown in the UI.
SITE_NAME=XyoLua FileDrop

# --- Uploads --------------------------------------------------------------
# Maximum total size of one drop (all files together). Units: B, KB, MB, GB, TB.
MAX_UPLOAD_SIZE=1GB
# Maximum number of files per drop.
MAX_FILES=20
# Total disk space all drops may use. 0 = unlimited.
MAX_STORAGE=0
# If set, uploading requires this password (recommended for public instances!).
# Downloading never needs it.
UPLOAD_PASSWORD=

# --- Drop options -----------------------------------------------------------
# Longest allowed lifetime of a drop. Units: s, m, h, d, w.
MAX_EXPIRY=7d
# Expiry presets offered in the UI (only values <= MAX_EXPIRY are shown).
EXPIRY_PRESETS=10m,1h,1d,3d,7d
DEFAULT_EXPIRY=1d
# Highest download limit a user can choose.
MAX_DOWNLOADS=1000
# Allow drops without a download limit (they still expire).
ALLOW_UNLIMITED_DOWNLOADS=true
# Allow sharing links (URL redirects) in addition to files.
ALLOW_LINKS=true
# Offer "download all as ZIP" for drops with several files.
ALLOW_ZIP=true

# --- Security ---------------------------------------------------------------
# Secret used to sign password-unlock cookies. If empty, a random secret is
# generated once and stored in DATA_DIR/.secret.
SECRET=
# Number of reverse proxies in front of FileDrop (nginx, Caddy, Traefik, ...).
# Needed so rate limits see the real client IP. 0 = FileDrop is reached directly.
TRUST_PROXY=0
# Uploads per IP and hour. 0 = no limit.
RATE_LIMIT_UPLOADS=30
# Wrong drop passwords per IP within 15 minutes before further attempts are blocked.
RATE_LIMIT_UNLOCK=10

# --- Housekeeping -----------------------------------------------------------
# How often expired drops are removed from disk.
CLEANUP_INTERVAL=1m
